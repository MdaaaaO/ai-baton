{
  "frontmatter": {
    "title": {
      "required": true
    },
    "type": {
      "const": "epic"
    },
    "domain": {
      "required": true
    },
    "status": {
      "required": true,
      "enum": [
        "active",
        "reference",
        "archived",
        "closed",
        "paused",
        "done"
      ]
    },
    "tags": {
      "kind": "list"
    },
    "updated": {
      "required": true,
      "kind": "date"
    }
  },
  "sections": [
    "Goal",
    "Key decisions & gotchas",
    "Remaining work",
    "Session log"
  ],
  "log": {
    "section": "Session log",
    "order": "oldest-first"
  },
  "version": 1,
  "migrations": [
    {
      "to": 1,
      "log_order": "oldest-first",
      "log_order_from": "newest-first",
      "replace_comments": [
        {
          "old": "newest first",
          "new": "oldest first"
        }
      ]
    }
  ]
}

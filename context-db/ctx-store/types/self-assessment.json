{
  "frontmatter": {
    "title": {
      "required": true
    },
    "type": {
      "const": "self-assessment"
    },
    "domain": {
      "required": true
    },
    "status": {
      "required": true,
      "enum": [
        "active",
        "reference",
        "archived",
        "closed",
        "paused",
        "done"
      ]
    },
    "tags": {
      "kind": "list"
    },
    "updated": {
      "required": true,
      "kind": "date"
    }
  }
}

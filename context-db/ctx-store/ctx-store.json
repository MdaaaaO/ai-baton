{
  "schema_version": 1,
  "generated": [
    "INDEX.md",
    "SESSION_INDEX.md",
    "sessions/archive/INDEX.md"
  ],
  "ignore": [
    "README.md",
    "**/README.md",
    "memory/**",
    "bin/**",
    "_templates/**",
    "**/_templates/**",
    "handoff/**",
    "on-call/handoff/**",
    "state/**"
  ],
  "resolve": {
    "key_regex": "[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+",
    "fields": [
      "epic"
    ],
    "section": "Tracker & links"
  },
  "mcp": {
    "actors": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
  },
  "maintain": {
    "keep_log": 6
  }
}

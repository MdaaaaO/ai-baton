{
  "autoCompactWindow": 200000,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "BATON": ".claude"
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/sync.sh\" >/dev/null 2>&1 || true",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/context-db/bin/ctx_adapter.py\" hook brief-registry 2>/dev/null || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/context-db/bin/ctx_adapter.py\" hook brief-session 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/context-db/bin/ctx_adapter.py\" hook post-tool-use 2>/dev/null || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/context-db/bin/ctx_adapter.py\" hook post-tool-use-async 2>/dev/null || true",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  }
}

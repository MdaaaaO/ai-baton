{
  "autoCompactWindow": 200000,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "BATON": ".claude"
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/sync.sh\" >/dev/null 2>&1 || true",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ]
  }
}

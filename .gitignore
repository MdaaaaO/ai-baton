# --- runtime / transient state (regenerated by the harness or scripts) ---
.DS_Store
scheduled_tasks.lock
settings.local.json
.sync.lock
.sync.lock.d/
.sync-status
.sync-preview
.sync-rejected
.sync-unverified
sync.log
__pycache__/
*.pyc
evals/results/
evals/*/results/

# sign-queue: pending jobs + per-job logs are transient (drained by `make sign` on the host)
sign-queue/*
!sign-queue/.gitkeep

# backups of ledgers
*.bak
*.bak-*

.review/
.review-delta/

# a leftover clone of the retired profiles layer must never block a pull (sync.sh refuses untracked files);
# kit-health warns while it exists — delete it
profiles/

# skills/pr-open's mermaid-check.mjs deps are meant to land in a scratchpad, not here — but ignore a stray
# in-place `npm ci` so it never gets committed by accident
node_modules/

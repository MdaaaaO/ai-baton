{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "K=\"${CLAUDE_PLUGIN_ROOT}/context-db/bin/kit_profile.py\"; [ -n \"${CLAUDE_ENV_FILE:-}\" ] && python3 \"$K\" session-env >> \"$CLAUDE_ENV_FILE\" 2>/dev/null; python3 \"$K\" workspace-rules 2>/dev/null; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

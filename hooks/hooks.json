{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "K=\"${CLAUDE_PLUGIN_ROOT}/context-db/bin/kit_profile.py\"\nS=\"$(python3 \"$K\" scratch 2>/dev/null)\"\nif [ -n \"$S\" ] && [ ! -L \"$S/hooks.log\" ] && ( : >>\"$S/hooks.log\" ) 2>/dev/null; then T=\"$S/hooks.log\"; else T=/dev/null; fi\nif [ -n \"${CLAUDE_ENV_FILE:-}\" ]; then\n  python3 \"$K\" session-env --update \"$CLAUDE_ENV_FILE\" 2>>\"$T\" || { if [ \"$T\" = /dev/null ]; then echo \"ai-baton: session-env failed writing to $CLAUDE_ENV_FILE - (no log available)\"; else echo \"ai-baton: session-env failed writing to $CLAUDE_ENV_FILE - see $T\"; fi; }\nfi\npython3 \"$K\" workspace-rules 2>>\"$T\" || echo \"ai-baton: the SessionStart hook could not load WORKSPACE.md (kit_profile.py workspace-rules failed) - the always-on rules are missing from this session; run /kit-health\"\nexit 0",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/context-db/bin/ctx_sync.py\" run --no-push --quiet --timeout 6 --lock-wait 2 2>/dev/null || true",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/context-db/bin/ctx_adapter.py\" hook brief-registry 2>/dev/null || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/context-db/bin/ctx_adapter.py\" hook brief-session 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/context-db/bin/ctx_adapter.py\" hook pre-tool-use 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/context-db/bin/ctx_adapter.py\" hook post-tool-use 2>/dev/null || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/context-db/bin/ctx_adapter.py\" hook post-tool-use-async 2>/dev/null || true",
            "timeout": 30,
            "async": true
          }
        ]
      },
      {
        "matcher": "mcp__.*ctx__ctx_.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/context-db/bin/ctx_adapter.py\" hook post-tool-use 2>/dev/null || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/context-db/bin/ctx_adapter.py\" hook post-tool-use-async 2>/dev/null || true",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  }
}

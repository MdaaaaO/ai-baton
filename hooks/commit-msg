#!/usr/bin/env bash
# Versioned commit-msg hook for the kit repo (installed with hooks/pre-push via core.hooksPath by
# setup.sh / sync.sh): every kit commit follows the repo's commit style — Conventional Commits by
# default, resolved by context-db/bin/commit_style.py (repo marker → env config → default).
# Other repos opt in with `git config core.hooksPath <abs>/.claude/hooks` — or rely on the same
# check in sign-queue/enqueue.sh and the pr-open checklist. KIT_SKIP_COMMIT_STYLE=1 bypasses once.
set -u
[ "${KIT_SKIP_COMMIT_STYLE:-0}" = "1" ] && exit 0
here=$(cd "$(dirname "$0")" && pwd)
top=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
# The checker of the tree being committed first: core.hooksPath points at ONE checkout's hooks/, so in a
# worktree whose branch changes the checker the hook-relative copy would judge by the old rule. The
# hook-relative copy is the fallback (a plugin install, or another repo that opted in with core.hooksPath).
checker="$top/context-db/bin/commit_style.py"
[ -f "$checker" ] || checker="$here/../context-db/bin/commit_style.py"
[ -f "$checker" ] || exit 0            # hook copied somewhere without the kit: nothing to check with
python3 "$checker" check --quiet --dir "$top" "$1"
rc=$?
case $rc in
  0) ;;
  1) echo "commit refused — fix the message (problem above; or KIT_SKIP_COMMIT_STYLE=1 for a deliberate one-off)" >&2; exit 1 ;;
  *) echo "commit refused — the style check itself failed (exit $rc, reason above): fix that, or KIT_SKIP_COMMIT_STYLE=1" >&2; exit 1 ;;
esac

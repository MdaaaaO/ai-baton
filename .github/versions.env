# Third-party tool versions the kit installs at run time — one pin per tool, bumped here only (via PR); nothing
# else names these versions, so drift between workflows is impossible. Shell steps source it (`. .github/versions.env`
# or `. .claude/.github/versions.env` on a checkout under that path); workspace.mk's kit_release recipe sources the
# copy in the checkout it is releasing (KIT_CHECKOUT), not its own.
#
# CLAUDE_CODE_VERSION: the CLI ci.yml, evals.yml and tree-review.yml install to validate the plugin manifests, run
# the eval suite and run the leak-by-meaning lens.
CLAUDE_CODE_VERSION=2.1.283
#
# CONVENTIONAL_RELEASE_VERSION: an exact version, not a floating range — release.yml, pr-title.yml and
# workspace.mk's kit_release all ran a different range before this file (docs/contributing.md § Releases);
# 0.3.1 is the version release.yml's `publish-release` step needs.
CONVENTIONAL_RELEASE_VERSION=0.3.1
